# ====================
# | Model parameters |
# ====================
#
# An's suggestions for high res (included):
# 
# viscAr= 5.6614e-04,
# no_slip_sides = .TRUE.,
# no_slip_bottom = .TRUE.,
# diffKrT=5.44e-7,
# diffKrS=5.44e-7,
