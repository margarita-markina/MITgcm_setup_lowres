# viscC4Leith=2.0,
# viscC4Leithd=2.0,
# viscA4GridMax=1.0,
# useAreaViscLength=.TRUE.,
#
#
# and 2 options for physics:
#
# Option A (most accurate):
#
# nonlinFreeSurf=4,
# select_rStar=1,
# useRealFreshWaterFlux=.TRUE.,
#
#
# Option B (vitual salt flux physics we want to avoid;
#           however this less accurate physics give more stability and less crashes;
#           use this option only if options A crushed complaining on too small vertical rstar or smth similar)
#
# select_rStar=0,
# nonlinFreeSurf=0,
# useRealFreshWaterFlux=.FALSE.,
#
# 
# Advection scheme:
#
# tempAdvScheme=7,
# saltAdvScheme=7,
# (Note: this requires OLx=OLy=8 in SIZE.h)
#
####### End of An's suggestions for high-res physics
